# Symphony's settings. Copy to symphony/.env — it is gitignored.
#
# OPTIONAL: every value below has a working default, so the file queue runs
# with no symphony/.env at all. You need one to use the GitLab tracker, to move
# the host paths, or to pin a different symphony-queue.
#
# Read by ./scripts/symphony only, and deliberately NOT part of the root .env:
# docker-compose.yml hands that file to the agent's container wholesale
# (`env_file: - .env`), so anything in it is visible to the agent. Symphony's
# tracker token must not be.
#
# Same parser rule as the root .env: comments on their OWN lines, never inline
# after a value.
#
# Read docs/SYMPHONY.md first. The containment that matters is the SCOPE OF THE
# GITLAB TOKEN, not these settings.

# === Image ===================================================================
# The symphony-queue version baked into the image. A tag or a full commit SHA —
# never a branch, or the image stops being reproducible.
SYMPHONY_REF=v0.4.0

# === Host paths ==============================================================
# The queue is the management UI: `ls`, `mv` and your editor are how you drive
# it. All six state directories live under one root because the claim is a
# rename(2) between them, which is only atomic within one filesystem.
SYMPHONY_QUEUE_PATH=./symphony-queue
# Per-item agent workspaces. Symphony clones fresh per item — do NOT point this
# at REPO_PATH or any working tree you care about.
SYMPHONY_WORKSPACES_PATH=./symphony-workspaces
# Directory holding WORKFLOW.md, mounted read-only because it is trusted config.
# Copy symphony/WORKFLOW.md.example to symphony/WORKFLOW.md to get started.
SYMPHONY_CONFIG_PATH=./symphony

SYMPHONY_LOG_LEVEL=info

# === GitLab tracker ==========================================================
# Set this ONLY when symphony/WORKFLOW.md says `tracker: { kind: gitlab }`.
# Leave it blank for the file queue and the symphony container keeps its
# stronger posture: no credentials and no egress whatsoever.
#
# It must be a PROJECT access token with the REPORTER role and `api` scope.
# Reporter can read and write issues on that one project and CANNOT push code —
# the agent's Developer token (GITLAB_PAT, in the root .env) does that, in the
# other container. Two tokens, neither able to do the other's job.
#
# `api` is full API access for that project; there is no issues-only scope. The
# ROLE is what constrains it. Get the role right.
SYMPHONY_GITLAB_TOKEN=

# Egress is not a setting: ./scripts/symphony routes symphony through squid
# automatically when the tracker is gitlab, and leaves it with no route off-host
# otherwise. Override with SYMPHONY_HTTP_PROXY only if squid is not the way out.

# === Developing symphony-queue itself ========================================
# A built checkout on the host, bind-mounted over the baked-in build by
# docker-compose.symphony-dev.yml. Leave blank otherwise — a bind mount means
# "whatever is in that directory right now", the opposite of what SYMPHONY_REF
# buys you.
SYMPHONY_SRC_PATH=
