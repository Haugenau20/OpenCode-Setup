# Copy this file to .env and fill in the blanks.
# .env is gitignored.
#
# IMPORTANT: keep comments on their OWN lines, never inline after a value.
# Some `docker compose` / .env parsers keep an inline `# comment` as part of
# the value, which silently breaks interpolated settings — e.g. an inline
# comment on OPENCODE_PORT drops the published port and the web UI stops
# working. Write `KEY=value` with nothing after the value.

# === Required: LLM ===========================================================
# These values are written to in-container 0600 files (/home/dev/secrets/) and
# referenced from opencode.json via {file:...} — do NOT wrap them in quotes
# here, as docker env_file passes quote characters literally into the container.
LLM_API_BASE=https://llm.internal.example/v1
# bearer token, per developer
LLM_API_KEY=

# === Bitbucket (git transport + REST API) ====================================
# One PAT covers BOTH git push/clone and the REST API, so no account password is
# stored anywhere. The REST API authenticates the PAT as a Bearer token
# (Bitbucket Data Center HTTP access tokens), so the MCP needs only
# BITBUCKET_BASE_URL + BITBUCKET_PAT — no username. It auto-enables when both are
# set (and DISABLE_BITBUCKET_MCP is not 1).
#
# BITBUCKET_BASE_URL is the REST API base — set it to your instance's canonical
# URL, no trailing slash. Prefer the HTTPS endpoint your server redirects to
# (e.g. https://bitbucket.internal.example:8443). The plain-HTTP connector (e.g.
# http://bitbucket.internal.example:7990) also serves the REST API, but a repo
# cloned from it can trigger an auth-redirect prompt — see docs/TROUBLESHOOTING.md
# and BITBUCKET_LEGACY_URL below. NOTE: https:// only works on the actual TLS
# port; pointing it at the plain-HTTP connector port gives a TLS "wrong version
# number" error.
BITBUCKET_BASE_URL=https://bitbucket.internal.example:8443
# your Bitbucket username — OPTIONAL: not used by the REST API (Bearer), only by
# the git credential helper for git-over-HTTPS clone/push. Set it if you clone
# Bitbucket over HTTPS; leave blank for SSH remotes or REST-only use.
BITBUCKET_USER=
# personal access token (Bearer for the REST API; also the git password over HTTPS)
BITBUCKET_PAT=
# OPTIONAL: a legacy Bitbucket URL that redirects to BITBUCKET_BASE_URL (e.g. the
# plain-HTTP connector http://bitbucket.internal.example:7990). When set, the
# container adds a git url.insteadOf rewrite so any repo remote still pointing
# here is transparently upgraded to BITBUCKET_BASE_URL before git connects — no
# redirect, no "Username for 'https://…'" prompt. Leave blank if you have none.
BITBUCKET_LEGACY_URL=

# === Jira (REST API only) ====================================================
# Optional. The Jira MCP auto-enables only when both are set; leave either blank
# to keep it off. Jira Data Center authenticates the PAT as a Bearer token, so
# no username is needed (unlike Bitbucket's Basic user:pat). Set BASE_URL to
# whatever scheme your Jira serves; no trailing slash.
JIRA_BASE_URL=
JIRA_PAT=

# === GitLab (git transport + REST API) =======================================
# One PAT covers BOTH git push/clone and the REST API — the REST API authenticates
# the PAT via the PRIVATE-TOKEN header (handled by the MCP server). The GitLab
# MCP auto-enables when all three values below are set (and DISABLE_GITLAB_MCP
# is not 1).
#
# GITLAB_BASE_URL is the REST API base. Unlike Bitbucket, the internal instance
# serves this over HTTPS — TLS is validated via the corp CA baked into ca/. No
# trailing slash.
GITLAB_BASE_URL=https://gitlab.internal.example
# your GitLab username
GITLAB_USER=
# personal access token (used for git AND the REST API)
GITLAB_PAT=

# === JFrog Artifactory (REST API only) =======================================
# Optional. JFrog is an artifact repository, not a git remote, so this is
# API-only — like Jira, not Bitbucket/GitLab. The access token is presented as
# a Bearer token, so no username is needed. The JFrog MCP auto-enables only when
# both values below are set (and DISABLE_JFROG_MCP is not 1); leave either blank
# to keep it off.
#
# JFROG_BASE_URL is the JFrog platform base (the MCP appends /artifactory/api).
# The internal instance is served over HTTPS — TLS is validated via the corp CA
# baked into ca/. No trailing slash. If your image registry (IMAGE_REGISTRY
# below) lives on the same host, point this there too.
JFROG_BASE_URL=https://jfrog.internal.example
# JFrog access token (Bearer); generate one under Identity & Access
JFROG_PAT=

# === Confluence (REST API only) ==============================================
# Optional. API-only — like Jira, not Bitbucket/GitLab. Confluence Data Center
# authenticates the PAT as a Bearer token, so no username is needed. The
# Confluence MCP auto-enables only when both values below are set (and
# DISABLE_CONFLUENCE_MCP is not 1); leave either blank to keep it off.
#
# CONFLUENCE_BASE_URL is the site base, no trailing slash (the MCP appends
# /rest/api). Confluence's default connector is HTTP on port 8090, so INCLUDE
# the port — that port is opened in squid.conf. If your instance is served over
# standard HTTPS instead, use https://confluence.internal.example with no port.
CONFLUENCE_BASE_URL=http://confluence.internal.example:8090
# Confluence personal access token (Bearer); create one under your profile
CONFLUENCE_PAT=
#
# The Confluence MCP is READ-ONLY unless ALLOW_CONFLUENCE_WRITE=1 (see "Safety
# switches" below) — creating and editing pages is off by default, exactly like
# remote git.

# === M-Files (REST API only) ==================================================
# Optional. API-only — like Jira/JFrog/Confluence, no git plane. M-Files does
# NOT use Authorization/Bearer or Basic — the PAT is presented via a custom
# `X-Authentication` header, so no username is needed. The M-Files MCP
# auto-enables only when both values below are set (and DISABLE_MFILES_MCP is
# not 1); leave either blank to keep it off.
#
# MFILES_BASE_URL is the site base, no trailing slash (the MCP appends /REST).
MFILES_BASE_URL=https://mfiles.internal.example
# M-Files session authentication token, sent as the X-Authentication header
# value. Unlike the other services you MINT this yourself: POST your vault
# credentials to /REST/server/authenticationtokens.aspx and paste the returned
# "Value" here. Step-by-step (incl. finding the vault GUID and token expiry):
# see "Getting an M-Files authentication token" in docs/MCP_SERVERS.md.
MFILES_PAT=

# === Git identity (for commits made inside the container) ====================
GIT_USER_NAME=
GIT_USER_EMAIL=

# === Per-project ============================================================
# used in compose project name + volumes
PROJECT_SLUG=myrepo
# change if running multiple stacks at once
OPENCODE_PORT=4096
# host path bind-mounted into /workspace
REPO_PATH=./repo

# === UID/GID (fix Linux bind-mount permissions) =============================
# Run `id -u` and `id -g` on the host and put the values here.
HOST_UID=1000
HOST_GID=1000

# === Safety switches =========================================================
# 1 enables git push/fetch/pull/clone
ALLOW_REMOTE_GIT=0
# 1 lets the Confluence MCP CREATE and EDIT pages (create_page, update_page,
# append_to_page, add_comment) instead of only reading them. Default 0 = the
# write tools are not registered at all, so the agent cannot see or call them.
# Only the exact value 1 enables writes. Deleting pages is never possible.
# Requires a restart to take effect (re-run the launcher / scripts/opencode).
ALLOW_CONFLUENCE_WRITE=0
# Escape hatch: force a service's MCP off even when its credentials are present.
# The MCPs are otherwise enabled automatically by credential presence above.
DISABLE_BITBUCKET_MCP=0
DISABLE_JIRA_MCP=0
DISABLE_GITLAB_MCP=0
DISABLE_JFROG_MCP=0
DISABLE_CONFLUENCE_MCP=0
DISABLE_MFILES_MCP=0

# === Plugins (opt-in) ========================================================
# Space- or comma-separated list of baked-in plugins to enable. Empty = none.
# Available: superpowers, dcp, opencode-workspace, opencode-pty. Edit this line
# and restart (re-run the launcher / scripts/opencode) to take effect. Example
# below. What each one is + upstream repos + pinned versions: see the README
# "Plugins" section (or docs/ADDING_PLUGINS.md). In the TUI, `/plugins` lists
# them live.
# Example: ENABLED_PLUGINS=superpowers dcp
ENABLED_PLUGINS=

# === Optional ===============================================================
# Bind-mount a host directory as the user layer (instead of a named volume).
# Convenient for adding skills/agents without entering the container.
# e.g. ./user-layer  (gitignored)
USER_LAYER_PATH=

# Set to enable HTTP basic auth on the opencode server. Leave empty for the
# default (localhost-only) case.
OPENCODE_SERVER_PASSWORD=

# Image tag to pull. `local` builds from source; a version number (e.g.
# `0.0.5`) pulls that release from the registry. See CHANGELOG.md for what
# each version contains.
IMAGE_TAG=local
IMAGE_REGISTRY=artifactory.internal.example/opencode-workplace

# OpenCode version baked into the image at build time. PIN THIS — do not use
# `latest`, or a rebuild can silently change OpenCode and break baked plugins.
# Bumping it is a deliberate act: re-test the plugins (esp. DCP, which rides a
# deprecated hook) after changing it.
OPENCODE_VERSION=1.17.15
