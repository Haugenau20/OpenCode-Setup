# Copy this file to .env and fill in the blanks. .env is gitignored.
#
# IMPORTANT: keep comments on their OWN lines, never inline after a value.
# Some `docker compose` / .env parsers keep an inline `# comment` as part of
# the value, which silently breaks interpolated settings — an inline comment on
# OPENCODE_PORT drops the published port and the web UI stops working.

# === Required: LLM ===========================================================
# Written to in-container 0600 files (/home/dev/secrets/) and referenced from
# opencode.json via {file:...}. Do NOT quote them: docker env_file passes quote
# characters into the container literally.
LLM_API_BASE=https://llm.internal.example/v1
LLM_API_KEY=

# === Credentials =============================================================
# Each MCP server auto-enables when its credentials are present, so leaving a
# block blank keeps that server absent — not disabled, absent. Base URLs take
# no trailing slash. Auth schemes, endpoints and how to mint each token:
# docs/MCP_SERVERS.md.

# Bitbucket — one PAT covers BOTH git push/clone and the REST API (Bearer), so
# no account password is stored anywhere. BITBUCKET_USER is only used by the
# git credential helper over HTTPS; the API does not need it.
# Point the base URL at the HTTPS connector — https:// on the plain-HTTP port
# gives a TLS "wrong version number" error.
BITBUCKET_BASE_URL=https://bitbucket.internal.example:8443
BITBUCKET_USER=
BITBUCKET_PAT=
# OPTIONAL: a legacy URL that redirects to BITBUCKET_BASE_URL (e.g. the
# plain-HTTP connector on :7990). Set it and git rewrites any remote still
# pointing there, so no auth-redirect prompt. See docs/TROUBLESHOOTING.md.
BITBUCKET_LEGACY_URL=

# Jira — REST only, PAT as Bearer.
JIRA_BASE_URL=
JIRA_PAT=

# GitLab — one PAT covers BOTH git and the REST API (PRIVATE-TOKEN header).
GITLAB_BASE_URL=https://gitlab.internal.example
GITLAB_USER=
GITLAB_PAT=

# JFrog Artifactory — REST only, access token as Bearer. Generate one under
# Identity & Access. If IMAGE_REGISTRY below is the same host, point it there.
JFROG_BASE_URL=https://jfrog.internal.example
JFROG_PAT=

# Confluence — REST only, PAT as Bearer. Read-only unless ALLOW_CONFLUENCE_WRITE
# is 1 (below). The default connector is HTTP on 8090, so INCLUDE the port —
# that port is opened in squid.conf. Use https:// with no port if yours is TLS.
CONFLUENCE_BASE_URL=http://confluence.internal.example:8090
CONFLUENCE_PAT=

# M-Files — REST only. The token goes in a custom X-Authentication header, and
# unlike the others you MINT it yourself: see "Getting an M-Files authentication
# token" in docs/MCP_SERVERS.md.
MFILES_BASE_URL=https://mfiles.internal.example
MFILES_PAT=

# === Git identity (for commits made inside the container) ====================
GIT_USER_NAME=
GIT_USER_EMAIL=

# === Per-project =============================================================
# used in the compose project name + volume names
PROJECT_SLUG=myrepo
# host port — change this to run several stacks side by side
OPENCODE_PORT=4096
# The port opencode binds INSIDE the container. Decoupled from OPENCODE_PORT so
# every stack can keep 4096 internally while differing on the host; everything
# that must agree on it (the socat publisher, any launcher overlay) derives here.
# You almost certainly do not need to change it.
OPENCODE_INTERNAL_PORT=4096
# host path bind-mounted into /workspace
REPO_PATH=./repo

# === UID/GID (fix Linux bind-mount permissions) ==============================
# Run `id -u` and `id -g` on the host.
HOST_UID=1000
HOST_GID=1000

# === Safety switches =========================================================
# All off by default. Each takes effect on restart (re-run the launcher).

# 1 enables git push/fetch/pull/clone.
ALLOW_REMOTE_GIT=0
# OPTIONAL second gate, applied only when ALLOW_REMOTE_GIT=1: restrict WHERE
# remote git may go. Whitespace- or comma-separated `host/path` prefixes,
# matched on a path-segment boundary. Empty = no restriction.
#   GIT_REMOTE_ALLOWLIST=gitlab.internal.example/sandbox/
GIT_REMOTE_ALLOWLIST=

# 1 lets the Confluence MCP create and edit pages instead of only reading them.
# Only the exact value 1 enables writes. Deleting pages is never possible.
ALLOW_CONFLUENCE_WRITE=0

# 1 lets the GitLab MCP open merge requests, comment, and create issues. Only
# the exact value 1 enables writes. Even at 1 there is deliberately no tool to
# set labels, close an issue or merge an MR — where an external orchestrator
# drives work through issue labels, the label IS the workflow state and that
# orchestrator owns it.
ALLOW_GITLAB_WRITE=0
# OPTIONAL narrowing, applied only when ALLOW_GITLAB_WRITE=1: restrict writes to
# these projects. Whitespace- or comma-separated paths or numeric ids, same
# segment-boundary rule — `mygroup` admits `mygroup/service`, not `mygroup-evil`.
#   GITLAB_WRITE_PROJECTS=mygroup/my-sandbox-project
GITLAB_WRITE_PROJECTS=
# Reserved label namespace the MCP may never set. Leave it alone unless an
# orchestrator drives this stack's issues under a different prefix.
GITLAB_QUEUE_LABEL_PREFIX=symphony

# Both allowlists are defence in depth, NOT security boundaries: an agent with a
# shell can call git and the API directly. They turn a mistake into a clear
# local error. The boundary is the token's scope and role — see
# docs/ARCHITECTURE.md, "The credential model".

# Escape hatch: force a service's MCP off even when its credentials are present.
DISABLE_BITBUCKET_MCP=0
DISABLE_JIRA_MCP=0
DISABLE_GITLAB_MCP=0
DISABLE_JFROG_MCP=0
DISABLE_CONFLUENCE_MCP=0
DISABLE_MFILES_MCP=0

# === Plugins (opt-in) ========================================================
# Space- or comma-separated list of baked-in plugins. Empty = none. Available:
# superpowers, dcp, opencode-workspace, opencode-pty. `/plugins` lists them live
# in the TUI; what each one is and its pinned version: docs/ADDING_PLUGINS.md.
# Example: ENABLED_PLUGINS=superpowers dcp
ENABLED_PLUGINS=

# === Optional ================================================================
# Bind-mount a host directory as the user layer instead of a named volume —
# convenient for adding skills/agents without entering the container.
# e.g. ./user-layer (gitignored)
USER_LAYER_PATH=

# HTTP basic auth on the opencode server. Empty = the default localhost-only case.
OPENCODE_SERVER_PASSWORD=

# Image tag to pull. `local` builds from source; a version number pulls that
# release from the registry. CHANGELOG.md says what each one contains.
IMAGE_TAG=local
IMAGE_REGISTRY=artifactory.internal.example/opencode-workplace

# OpenCode version baked into the image at build time. PIN THIS — `latest` can
# silently change OpenCode and break baked plugins. Bumping it is a deliberate
# act: re-test the plugins (especially DCP) afterwards.
OPENCODE_VERSION=1.17.15
