# Copy this file to .env and fill in the blanks.
# .env is gitignored.

# === Required: LLM ===========================================================
LLM_API_BASE=https://llm.internal.example/v1
LLM_API_KEY=                       # bearer token, per developer

# === Required: Bitbucket =====================================================
BITBUCKET_USER=                    # your Bitbucket username
BITBUCKET_PAT=                     # personal access token

# === Git identity (for commits made inside the container) ====================
GIT_USER_NAME=
GIT_USER_EMAIL=

# === Per-project ============================================================
PROJECT_SLUG=myrepo                # used in compose project name + volumes
OPENCODE_PORT=4096                 # change if running multiple stacks at once
REPO_PATH=./repo                   # host path bind-mounted into /workspace

# === UID/GID (fix Linux bind-mount permissions) =============================
# Run `id -u` and `id -g` on the host and put the values here.
HOST_UID=1000
HOST_GID=1000

# === Safety switches =========================================================
ALLOW_REMOTE_GIT=0                 # 1 enables git push/fetch/pull/clone
ENABLE_SESSION_LOGS=1              # 0 swaps session state for tmpfs

# === Optional ===============================================================
# Bind-mount a host directory as the user layer (instead of a named volume).
# Convenient for adding skills/agents without entering the container.
USER_LAYER_PATH=                   # e.g. ./user-layer  (gitignored)

# Set to enable HTTP basic auth on the opencode server. Leave empty for the
# default (localhost-only) case.
OPENCODE_SERVER_PASSWORD=

# Image tag to pull. `local` builds from source; `:staging` / `:prod` pull
# from the registry.
IMAGE_TAG=local
IMAGE_REGISTRY=artifactory.internal.example/opencode-workplace
