#!/usr/bin/env bash
# Host-side wrapper for the symphony overlay — the counterpart to
# ./scripts/opencode. Composes the right -f flags, refuses to start on a
# misconfiguration that would otherwise fail confusingly ten minutes in, and
# gives you the handful of verbs you actually need while testing.
#
#   ./scripts/symphony up          # build if needed + start + show status
#   ./scripts/symphony logs        # follow the orchestrator log
#   ./scripts/symphony status      # queue counts, per-state
#   ./scripts/symphony watch       # status, refreshed
#   ./scripts/symphony add "..."   # drop a new item into todo/
#   ./scripts/symphony stop        # stop symphony, leave opencode running
#   ./scripts/symphony down        # stop the whole stack
#   ./scripts/symphony build       # rebuild the symphony image
#   ./scripts/symphony check       # preflight only, change nothing
#   ./scripts/symphony projects    # list the projects in this checkout
#   ./scripts/symphony config      # the fully resolved compose config
#
# Every verb takes `-p <slug>` (or SYMPHONY_PROJECT=<slug>) to select one of the
# stacks under projects/. Without it the root .env and symphony/.env are the
# whole configuration — the single-project setup, unchanged.
#
#   ./scripts/symphony -p acme-api up
#
# New projects come from ./scripts/new-project.sh. Layout and the layering
# rules: projects/README.md.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

red()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[32m%s\033[0m\n' "$*"; }
info() { printf '%s\n' "$*"; }

# Load .env WITHOUT sourcing it — same reasoning as scripts/opencode: sourcing
# executes each line, so an unquoted multi-word value becomes a command.
load_env() {
    local file="$1" line
    while IFS= read -r line || [ -n "${line}" ]; do
        line="${line%$'\r'}"
        case "${line}" in ''|\#*) continue ;; esac
        case "${line}" in [A-Za-z_]*=*) export "${line}" ;; esac
    done < "${file}"
}

# --- project selection -------------------------------------------------------
# Leading options only, so a verb's own arguments are never mistaken for one —
# `add "-p is a weird thing to write"` still queues that text.
PROJECT="${SYMPHONY_PROJECT:-}"
while [ "$#" -gt 0 ]; do
    case "$1" in
        -p|--project)
            [ "$#" -ge 2 ] || { red "-p needs a project slug"; exit 1; }
            PROJECT="$2"; shift 2 ;;
        -p=*|--project=*)
            PROJECT="${1#*=}"; shift ;;
        *) break ;;
    esac
done

# The slug becomes a path component and a compose project name, so it is
# validated before either use — the same character class the tracker accepts for
# an item id, which also rules out `..` and anything with a slash in it.
if [ -n "${PROJECT}" ]; then
    case "${PROJECT}" in
        *[!A-Za-z0-9._-]*|.*|-*|"")
            red "invalid project slug: ${PROJECT}"
            red "  letters, digits, dot, underscore and dash; must start with a letter or digit"
            exit 1 ;;
    esac
    PROJECT_DIR="./projects/${PROJECT}"
    [ -d "${PROJECT_DIR}" ] || {
        red "no such project: ${PROJECT_DIR}"
        red "  create it:  ./scripts/new-project.sh ${PROJECT}"
        red "  list them:  ./scripts/symphony projects"
        exit 1
    }
fi

# --- configuration layers -----------------------------------------------------
# Four files, read in this order, last value winning:
#
#   .env                            shared, agent-visible
#   symphony/.env                   shared, launcher-only
#   projects/<slug>/.env            per-project, agent-visible
#   projects/<slug>/symphony.env    per-project, launcher-only
#
# The agent/launcher split is the older one and unchanged: docker-compose.yml
# hands the agent-visible files to its container wholesale, so symphony's
# tracker token lives only in files that directive never names.
#
# The shared/per-project split is what lets one checkout run many stacks. Both
# per-project files are optional — a project that only overrides credentials
# needs no symphony.env at all.
[ -f .env ] || { red "no .env found. Copy .env.example to .env and edit it first."; exit 1; }
load_env ./.env

SYMPHONY_ENV="./symphony/.env"
[ -f "${SYMPHONY_ENV}" ] && load_env "${SYMPHONY_ENV}"

PROJECT_ENV=""
PROJECT_SYMPHONY_ENV=""
if [ -n "${PROJECT}" ]; then
    PROJECT_ENV="${PROJECT_DIR}/.env"
    PROJECT_SYMPHONY_ENV="${PROJECT_DIR}/symphony.env"

    # Derived BEFORE the project's own files are read, so an explicit value in
    # them still wins. Deliberately after the shared files, though: symphony/.env
    # ships concrete paths (./symphony-queue, ./symphony-workspaces), and a
    # shared file must not be able to collapse every project onto one queue.
    # Silent cross-project aliasing is the worst failure this layout can have —
    # two orchestrators claiming the same item is exactly what the rename(2)
    # argument in docs/SYMPHONY.md assumes cannot happen.
    export PROJECT_SLUG="${PROJECT}"
    export SYMPHONY_CONFIG_PATH="${PROJECT_DIR}/config"
    export SYMPHONY_QUEUE_PATH="${PROJECT_DIR}/queue"
    export SYMPHONY_WORKSPACES_PATH="${PROJECT_DIR}/workspaces"
    # Opt-in: a project only gets its own egress surface if it ships one.
    # Otherwise it shares the checkout-wide extra-allowlist.d, as before.
    [ -d "${PROJECT_DIR}/allowlist.d" ] && export EXTRA_ALLOWLIST_PATH="${PROJECT_DIR}/allowlist.d"

    [ -f "${PROJECT_ENV}" ] && load_env "${PROJECT_ENV}"
    [ -f "${PROJECT_SYMPHONY_ENV}" ] && load_env "${PROJECT_SYMPHONY_ENV}"

    # Read by docker-compose.yml's `env_file:` list — the ONLY way per-project
    # values reach the agent's container. Everything else here is compose
    # interpolation, which is a different mechanism.
    [ -f "${PROJECT_ENV}" ] && export PROJECT_ENV_FILE="${PROJECT_ENV}"
fi

PROJECT_SLUG="${PROJECT_SLUG:-default}"
QUEUE_PATH="${SYMPHONY_QUEUE_PATH:-./symphony-queue}"
WORKSPACES_PATH="${SYMPHONY_WORKSPACES_PATH:-./symphony-workspaces}"
CONFIG_PATH="${SYMPHONY_CONFIG_PATH:-./symphony}"
WORKFLOW="${CONFIG_PATH}/WORKFLOW.md"
SYMPHONY_CONTAINER="opencode-symphony-${PROJECT_SLUG}"

# Every file has to reach compose's interpolation, and passing --env-file at all
# disables its default ./.env discovery — so the root file is named explicitly
# too. Same order as the loads above, so compose resolves ${VAR} exactly as this
# script did. (The launcher's own exported environment outranks all of them,
# which is what makes the derived per-project paths stick.)
COMPOSE=(docker compose --env-file .env)
[ -f "${SYMPHONY_ENV}" ] && COMPOSE+=(--env-file "${SYMPHONY_ENV}")
[ -n "${PROJECT_ENV}" ] && [ -f "${PROJECT_ENV}" ] && COMPOSE+=(--env-file "${PROJECT_ENV}")
[ -n "${PROJECT_SYMPHONY_ENV}" ] && [ -f "${PROJECT_SYMPHONY_ENV}" ] && COMPOSE+=(--env-file "${PROJECT_SYMPHONY_ENV}")
# Container names and volumes are all ${PROJECT_SLUG}-suffixed, but the compose
# PROJECT NAME is what makes two stacks separate objects to compose itself —
# without -p, `up` on one would treat the other's containers as orphans.
COMPOSE+=(-p "opencode-${PROJECT_SLUG}")
COMPOSE+=(-f docker-compose.yml)
[ -n "${USER_LAYER_PATH:-}" ] && COMPOSE+=(-f docker-compose.user-layer.yml)
COMPOSE+=(-f docker-compose.symphony.yml)
# Developing symphony-queue itself: bind-mount a host checkout over the baked
# build. Opt in by setting SYMPHONY_SRC_PATH in symphony/.env.
if [ -n "${SYMPHONY_SRC_PATH:-}" ]; then
    COMPOSE+=(-f docker-compose.symphony-dev.yml)
fi

# --- preflight ---------------------------------------------------------------
# Everything here is a mistake that otherwise surfaces as a confusing failure
# well after start-up, or worse, as an unattended agent doing something you did
# not intend. Cheap to check, expensive to debug.

tracker_kind() {
    [ -f "${WORKFLOW}" ] || return 0
    sed -n '/^---$/,/^---$/p' "${WORKFLOW}" \
        | sed -n 's/^[[:space:]]*kind:[[:space:]]*\([a-z_]*\).*/\1/p' | head -1
}

# wf_scalar <key> — first `key: value` in the front matter, comments and quotes
# stripped. Commented-out lines never match: the key has to start the line
# (after indentation), so a leading `#` disqualifies it.
wf_scalar() {
    [ -f "${WORKFLOW}" ] || return 0
    sed -n '/^---$/,/^---$/p' "${WORKFLOW}" \
        | sed -n "s/^[[:space:]]*$1:[[:space:]]*\(.*\)\$/\1/p" | head -1 \
        | sed 's/[[:space:]]#.*$//; s/[[:space:]]*$//; s/^["'"'"']//; s/["'"'"']$//'
}

# --- egress ------------------------------------------------------------------
# Symphony needs a route off-host for exactly one reason: the gitlab tracker
# talks to the API. Both its networks are `internal: true`, so squid is the only
# way out and the address is fixed by the compose service name — which made this
# a setting whose sole possible value was `http://squid:3128` and whose only
# other state was "you forgot it, run aborted". Derive it from the tracker
# instead. On the file queue it stays empty and symphony has no egress at all.
# An explicit SYMPHONY_HTTP_PROXY still wins, for a stack where squid is not the
# way out.
derive_egress() {
    [ "$(tracker_kind)" = "gitlab" ] || return 0
    export SYMPHONY_HTTP_PROXY="${SYMPHONY_HTTP_PROXY:-http://squid:3128}"
}
derive_egress

# --- allowlist agreement ------------------------------------------------------
# GIT_REMOTE_ALLOWLIST (git plane, enforced by opencode/git-guard) and
# GITLAB_WRITE_PROJECTS (API plane, enforced by the MCP write gate) express
# nearly the same intent in two formats, and nothing at runtime makes them
# agree — they are read by different processes gating different protocols, which
# is why both exist and why neither can check the other. Set one, forget the
# other, and you get lopsided containment: an agent that pushes a branch it
# cannot open an MR for, or the reverse. Both failures land mid-run, unattended.

# norm_dest <url|path> — reduce a destination to `host/path`, or a bare project
# path when there is no host. Drops scheme, userinfo, port, trailing `.git` and
# surrounding slashes, and lowercases. Same normalization as git-guard's
# normalize_remote and the MCP gate's normalizeProject, so all three agree on
# what an entry means.
norm_dest() {
    local url="${1}" host rest
    url="${url%%\?*}"
    case "${url}" in
        *://*)
            url="${url#*://}"; url="${url#*@}"
            host="${url%%/*}"; rest=""
            case "${url}" in */*) rest="/${url#*/}" ;; esac
            host="${host%%:*}"; url="${host}${rest}"
            ;;
        /*|./*|../*|~*) ;;
        *:*) url="${url#*@}"; url="${url%%:*}/${url#*:}" ;;
    esac
    url="${url#/}"; url="${url%/}"; url="${url%.git}"
    printf '%s' "${url}" | tr '[:upper:]' '[:lower:]'
}

# path_of <host/a/b> — the path part, empty for a host-only entry (which admits
# every project on that host).
path_of() {
    case "${1}" in */*) printf '%s' "${1#*/}" ;; *) printf '' ;; esac
}

# covered_by <needle> <entry>... — prefix match on a path-segment boundary, so
# `a/b` admits `a/b` and `a/b/c` and refuses `a/b-evil`. The rule both gates
# already use. A host-only (empty) entry covers everything.
covered_by() {
    local needle="${1}" entry; shift
    for entry in "$@"; do
        [ -n "${entry}" ] || return 0
        case "${needle}/" in "${entry}"/*) return 0 ;; esac
    done
    return 1
}

allowlist_agreement() {
    local raw e remotes=() remote_paths=() writes=()
    raw="${GIT_REMOTE_ALLOWLIST:-}"
    for e in ${raw//,/ }; do
        e="$(norm_dest "${e}")"; [ -n "${e}" ] && remotes+=("${e}")
    done
    raw="${GITLAB_WRITE_PROJECTS:-}"
    for e in ${raw//,/ }; do
        e="$(norm_dest "${e}")"; [ -n "${e}" ] && writes+=("${e}")
    done
    for e in "${remotes[@]:-}"; do
        [ -n "${e}" ] && remote_paths+=("$(path_of "${e}")")
    done

    # Only meaningful when both planes are on AND both are narrowed; the
    # "switch on, list empty" cases are already warned about above.
    if [ "${ALLOW_REMOTE_GIT:-0}" = "1" ] && [ "${ALLOW_GITLAB_WRITE:-0}" = "1" ] \
       && [ "${#remotes[@]}" -gt 0 ] && [ "${#writes[@]}" -gt 0 ]; then
        for e in "${writes[@]}"; do
            covered_by "${e}" "${remote_paths[@]}" || {
                warn "  ! ${e} is in GITLAB_WRITE_PROJECTS but no GIT_REMOTE_ALLOWLIST entry covers it"
                warn "    the agent could open a merge request there and could not push the branch for it"
            }
        done
        for e in "${remote_paths[@]}"; do
            [ -n "${e}" ] || continue
            covered_by "${e}" "${writes[@]}" || {
                warn "  ! ${e} is pushable per GIT_REMOTE_ALLOWLIST but not in GITLAB_WRITE_PROJECTS"
                warn "    the agent could push a branch there and could not open the merge request"
            }
        done
    fi

    # The tracker's own project is the one destination that definitely matters:
    # the workflow tells the agent to clone it, so both gates have to admit it.
    [ "$(tracker_kind)" = "gitlab" ] || return 0
    local base project dest
    base="$(norm_dest "$(wf_scalar base_url)")"
    project="$(norm_dest "$(wf_scalar project_id)")"
    [ -n "${base}" ] && [ -n "${project}" ] || return 0
    # A numeric project_id is a valid GitLab reference but carries no path, so
    # there is nothing for an allowlist to be compared against.
    case "${project}" in *[!0-9]*) : ;; *) return 0 ;; esac
    dest="${base}/${project}"

    if [ "${ALLOW_REMOTE_GIT:-0}" = "1" ] && [ "${#remotes[@]}" -gt 0 ]; then
        covered_by "${dest}" "${remotes[@]}" \
            && ok "  ✓ tracker project ${dest} is git-reachable and API-writable" \
            || {
                warn "  ! tracker project ${dest} is not covered by GIT_REMOTE_ALLOWLIST"
                warn "    the workflow tells the agent to clone it and git-guard will refuse"
            }
    fi
    if [ "${ALLOW_GITLAB_WRITE:-0}" = "1" ] && [ "${#writes[@]}" -gt 0 ]; then
        covered_by "${project}" "${writes[@]}" || {
            warn "  ! tracker project ${project} is not in GITLAB_WRITE_PROJECTS"
            warn "    the agent could not open a merge request against the project it is working"
        }
    fi
}

preflight() {
    local fatal=0 kind stale
    if [ -n "${PROJECT}" ]; then
        info "preflight (project: ${PROJECT_SLUG}, from ${PROJECT_DIR})"
    else
        info "preflight (project: ${PROJECT_SLUG})"
    fi

    # An AGENT-visible env file must not sit inside the directory mounted at
    # /config. That mount is symphony's, and symphony is supposed to hold the
    # Reporter token and nothing else — the whole point of the two-token split.
    # The agent's Developer token readable from inside the orchestrator quietly
    # undoes it.
    #
    # Narrowly about the agent's files, matched by inode rather than by name:
    # symphony/.env is in the default config directory and is fine there, being
    # symphony's own token in symphony's own container. The case that is not
    # fine is SYMPHONY_CONFIG_PATH pointing at a project directory, which holds
    # the agent's .env one level above its config/.
    if [ -d "${CONFIG_PATH}" ]; then
        local found agent_env
        for found in "${CONFIG_PATH}"/.env "${CONFIG_PATH}"/*.env; do
            [ -f "${found}" ] || continue
            for agent_env in .env ${PROJECT_ENV:+"${PROJECT_ENV}"}; do
                [ -f "${agent_env}" ] || continue
                if [ "${found}" -ef "${agent_env}" ]; then
                    red "  ✗ ${agent_env} is inside ${CONFIG_PATH}, which is mounted into the symphony container"
                    red "    symphony would be able to read the agent's credentials — point"
                    red "    SYMPHONY_CONFIG_PATH at a subdirectory holding only WORKFLOW.md"
                    fatal=1
                fi
            done
        done
    fi

    # PROJECT_SLUG drives container names and volume names; the directory name
    # drives the queue, workspaces and WORKFLOW.md paths. When they disagree,
    # `docker ps` and `ls projects/` describe different things and every later
    # message in this script names the wrong one.
    if [ -n "${PROJECT}" ] && [ "${PROJECT_SLUG}" != "${PROJECT}" ]; then
        warn "  ! PROJECT_SLUG is '${PROJECT_SLUG}' but the project directory is '${PROJECT}'"
        warn "    containers and volumes will be named for the former, paths for the latter"
    fi

    # SYMPHONY_* used to live in the root .env. They still work from there — the
    # launcher loads both — but docker-compose.yml passes that whole file into
    # the AGENT's container, so a tracker token left behind is a token the agent
    # can read. Nothing else warns about this, because nothing else sees both
    # files.
    # Both agent-visible files get this check: docker-compose.yml passes them to
    # the AGENT's container wholesale, so a tracker token in either is a token
    # the agent can read. It still WORKS from there — this script loads every
    # layer — which is exactly why it needs saying.
    local agent_file
    for agent_file in .env ${PROJECT_ENV:+"${PROJECT_ENV}"}; do
        [ -f "${agent_file}" ] || continue
        if stale="$(grep -oE '^SYMPHONY_[A-Z_]+' "${agent_file}" | tr '\n' ' ')" && [ -n "${stale}" ]; then
            warn "  ! SYMPHONY_* keys in ${agent_file}: ${stale}"
            warn "    move them to ${PROJECT_SYMPHONY_ENV:-${SYMPHONY_ENV}} — ${agent_file} is handed to the agent's container"
        fi
    done

    # Same parser footgun the root .env carries, and the same fix: some .env
    # readers keep an inline `# comment` as part of the value. doctor.sh checks
    # the root file; nothing else looks at these.
    local launcher_file inline
    for launcher_file in ${SYMPHONY_ENV:+"${SYMPHONY_ENV}"} ${PROJECT_SYMPHONY_ENV:+"${PROJECT_SYMPHONY_ENV}"}; do
        [ -f "${launcher_file}" ] || continue
        if inline="$(grep -nE '^[A-Za-z_][A-Za-z0-9_]*=[^#]*[[:space:]]#' "${launcher_file}")"; then
            red "  ✗ inline '#' comments in ${launcher_file} — move them to their own lines:"
            printf '      %s\n' "${inline}" >&2
            fatal=1
        fi
    done

    if [ ! -f "${WORKFLOW}" ]; then
        # The examples ship in ./symphony/ and stay there — a project's config
        # directory holds its own WORKFLOW.md, not another copy of the templates.
        red "  ✗ no ${WORKFLOW}"
        red "    cp ./symphony/WORKFLOW.md.example ${WORKFLOW}          # file queue"
        red "    cp ./symphony/WORKFLOW.gitlab.md.example ${WORKFLOW}   # GitLab issues"
        fatal=1
    else
        kind="$(tracker_kind)"
        ok "  ✓ workflow: ${WORKFLOW} (tracker: ${kind:-unknown})"
    fi

    # The workspaces bind mount must never be your real repo: symphony clones
    # per item and treats the directory as disposable.
    local ws_abs repo_abs
    ws_abs="$(cd "$(dirname "${WORKSPACES_PATH}")" 2>/dev/null && pwd)/$(basename "${WORKSPACES_PATH}")" || ws_abs="${WORKSPACES_PATH}"
    if [ -n "${REPO_PATH:-}" ]; then
        repo_abs="$(cd "${REPO_PATH}" 2>/dev/null && pwd)" || repo_abs=""
        if [ -n "${repo_abs}" ] && [ "${ws_abs}" = "${repo_abs}" ]; then
            red "  ✗ SYMPHONY_WORKSPACES_PATH is the same directory as REPO_PATH"
            red "    symphony treats workspaces as disposable — point it somewhere else"
            fatal=1
        fi
    fi

    case "${kind}" in
        gitlab)
            if [ -n "${SYMPHONY_GITLAB_TOKEN:-}" ]; then
                ok "  ✓ SYMPHONY_GITLAB_TOKEN set (should be a Reporter project token)"
            else
                red "  ✗ tracker is gitlab but SYMPHONY_GITLAB_TOKEN is empty"
                if [ -n "${PROJECT_SYMPHONY_ENV}" ]; then
                    red "    set it in ${PROJECT_SYMPHONY_ENV} — a Reporter token reaches one project,"
                    red "    so it belongs to this project and not to the shared ${SYMPHONY_ENV}"
                else
                    red "    set it in ${SYMPHONY_ENV} (cp symphony/.env.example symphony/.env)"
                fi
                fatal=1
            fi
            ok "  ✓ egress: ${SYMPHONY_HTTP_PROXY} (symphony reaches GitLab via squid)"
            if [ "${SYMPHONY_GITLAB_TOKEN:-}" = "${GITLAB_PAT:-}" ] && [ -n "${GITLAB_PAT:-}" ]; then
                warn "  ! SYMPHONY_GITLAB_TOKEN and GITLAB_PAT are the same token"
                warn "    the split only means anything if symphony's is Reporter and the agent's is Developer"
            fi
            # A Reporter token inherited from the shared symphony/.env reaches
            # ONE project — whichever it was minted for. Used by a second stack
            # it either 404s (confusing) or, if it happens to be a group token,
            # hands that stack more reach than its own project. Either way the
            # per-project token is the thing that makes the boundary per-project.
            if [ -n "${PROJECT}" ] && [ -n "${SYMPHONY_GITLAB_TOKEN:-}" ] \
               && [ -f "${SYMPHONY_ENV}" ] \
               && { [ ! -f "${PROJECT_SYMPHONY_ENV}" ] \
                    || ! grep -qE '^SYMPHONY_GITLAB_TOKEN=.' "${PROJECT_SYMPHONY_ENV}"; } \
               && grep -qE '^SYMPHONY_GITLAB_TOKEN=.' "${SYMPHONY_ENV}"; then
                warn "  ! SYMPHONY_GITLAB_TOKEN comes from the shared ${SYMPHONY_ENV}"
                warn "    a project access token reaches one project — give ${PROJECT} its own in"
                warn "    ${PROJECT_SYMPHONY_ENV}"
            fi
            ;;
        file_queue|"")
            [ -z "${SYMPHONY_GITLAB_TOKEN:-}" ] \
                && ok "  ✓ file queue: symphony holds no credentials" \
                || warn "  ! SYMPHONY_GITLAB_TOKEN is set but the tracker is the file queue — it is unused"
            ;;
    esac

    if [ "${ALLOW_REMOTE_GIT:-0}" = "1" ]; then
        if [ -n "${GIT_REMOTE_ALLOWLIST:-}" ]; then
            ok "  ✓ remote git ON, restricted to: ${GIT_REMOTE_ALLOWLIST}"
        else
            warn "  ! remote git is ON and GIT_REMOTE_ALLOWLIST is EMPTY"
            warn "    an unattended agent may push to any remote its token can reach"
        fi
    else
        ok "  ✓ remote git OFF — the agent can commit but cannot push (good for early runs)"
    fi

    if [ "${ALLOW_GITLAB_WRITE:-0}" = "1" ] && [ -z "${GITLAB_WRITE_PROJECTS:-}" ]; then
        warn "  ! ALLOW_GITLAB_WRITE=1 with no GITLAB_WRITE_PROJECTS — writes are not project-limited"
    fi

    allowlist_agreement

    # Concurrency/turns come from WORKFLOW.md; surface them because they are the
    # two numbers most worth keeping small while you are still learning.
    if [ -f "${WORKFLOW}" ]; then
        local turns conc
        turns="$(sed -n 's/^[[:space:]]*max_turns:[[:space:]]*\([0-9]*\).*/\1/p' "${WORKFLOW}" | head -1)"
        conc="$(sed -n 's/^[[:space:]]*max_concurrent_agents:[[:space:]]*\([0-9]*\).*/\1/p' "${WORKFLOW}" | head -1)"
        info "  · max_turns=${turns:-?}  max_concurrent_agents=${conc:-?}"
        [ -n "${conc}" ] && [ "${conc}" -gt 1 ] 2>/dev/null \
            && warn "  ! more than one agent at a time — consider 1 until you trust a full run"
    fi

    [ "${fatal}" -eq 0 ] || { red "preflight failed — nothing started."; exit 1; }
}

ensure_dirs() {
    local d
    # Workspaces are used by both trackers — the agent gets one per item
    # whatever the queue is made of. The six state directories are the file
    # queue's storage and mean nothing under the gitlab tracker, so creating
    # them there would be inventing a second, empty board next to the real one.
    mkdir -p "${WORKSPACES_PATH}"
    [ "$(tracker_kind)" = "gitlab" ] && return 0
    for d in todo in-progress review done failed cancelled; do
        mkdir -p "${QUEUE_PATH}/${d}"
    done
}

container_state() {
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "${SYMPHONY_CONTAINER}"; then
        printf '\n  symphony: running\n'
    else
        printf '\n  symphony: NOT running\n'
    fi
}

queue_status() {
    # Report the board symphony is actually reading. Printing file counts under
    # the gitlab tracker is worse than printing nothing: leftovers from an
    # earlier file-queue run show up as "todo 1" for a queue symphony is not
    # looking at, which reads as work that is about to be picked up.
    if [ "$(tracker_kind)" = "gitlab" ]; then
        local base project
        base="$(wf_scalar base_url)"
        project="$(wf_scalar project_id)"
        printf '\n  tracker: gitlab — %s\n' "${project:-<project_id unset>}"
        if [ -n "${base}" ] && [ -n "${project}" ]; then
            case "${project}" in
                *[!0-9]*) printf '    board: %s/%s/-/issues?label_name[]=%s::todo\n' \
                              "${base%/}" "${project}" "$(wf_scalar label_prefix)" ;;
                *)        printf '    board: %s (project id %s)\n' "${base%/}" "${project}" ;;
            esac
        fi
        printf '    queue state lives in the issues themselves — ./scripts/symphony logs\n'
        printf '\n  workspaces: %s\n' "${WORKSPACES_PATH}"
        container_state
        return 0
    fi

    local d n total=0
    printf '\n  queue: %s\n' "${QUEUE_PATH}"
    for d in todo in-progress review failed done cancelled; do
        # -d first: `find` on a missing directory exits non-zero, and under
        # `set -o pipefail` that aborts the whole script. Reachable on any queue
        # whose state directories have not been created yet — a freshly
        # scaffolded project, or `status` before the first `up`.
        if [ ! -d "${QUEUE_PATH}/${d}" ]; then
            printf '    %-12s -\n' "${d}"
            continue
        fi
        n=$(find "${QUEUE_PATH}/${d}" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
        total=$((total + n))
        [ "${n}" -gt 0 ] && printf '    %-12s %s\n' "${d}" "${n}" || printf '    %-12s -\n' "${d}"
    done
    [ "${total}" -eq 0 ] && printf '\n  queue is empty — add work with: ./scripts/symphony add "..."\n'
    container_state
}

# --- verbs -------------------------------------------------------------------

cmd="${1:-up}"
[ "$#" -gt 0 ] && shift || true

case "${cmd}" in
    check)
        preflight
        ok "preflight passed."
        ;;

    build)
        preflight
        "${COMPOSE[@]}" build symphony "$@"
        ;;

    up|start)
        preflight
        ensure_dirs
        info "starting stack..."
        "${COMPOSE[@]}" up -d "$@"
        queue_status
        printf '\n  logs:  ./scripts/symphony logs\n  stop:  ./scripts/symphony stop\n\n'
        ;;

    logs)
        "${COMPOSE[@]}" logs -f --tail=100 symphony "$@"
        ;;

    config)
        # The fully resolved stack, after four env layers and the derived
        # per-project paths. With one env file you can read the file; with four
        # plus derivation, "what did this actually resolve to" needs answering
        # by the thing that did the resolving.
        "${COMPOSE[@]}" config "$@"
        ;;

    status)
        queue_status
        ;;

    projects)
        # `ls projects/` with the two facts you cannot see from the directory
        # name: which tracker it is on, and whether it is up. Reads each
        # project's files directly rather than re-entering this script per
        # project — nothing here needs the full layered configuration.
        if [ ! -d ./projects ] || [ -z "$(find ./projects -mindepth 1 -maxdepth 1 -type d 2>/dev/null)" ]; then
            printf '\n  no projects yet — create one with:\n'
            printf '    ./scripts/new-project.sh <slug> [repo-path]\n\n'
            printf '  the root .env and symphony/.env are still a complete\n'
            printf '  single-project setup; -p is what opts into this directory.\n\n'
            exit 0
        fi
        printf '\n  %-20s %-7s %-11s %s\n' SLUG PORT TRACKER STATE
        for d in ./projects/*/; do
            [ -d "${d}" ] || continue
            s="$(basename "${d}")"
            wf="${d}config/WORKFLOW.md"
            k="-"
            [ -f "${wf}" ] && k="$(sed -n '/^---$/,/^---$/p' "${wf}" \
                | sed -n 's/^[[:space:]]*kind:[[:space:]]*\([a-z_]*\).*/\1/p' | head -1)"
            # The port is read, not resolved: it is written once at scaffold
            # time and is a plain setting thereafter.
            p="$(sed -n 's|^OPENCODE_PORT=\(.*\)$|\1|p' "${d}.env" 2>/dev/null | tail -n1)"
            if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "opencode-symphony-${s}"; then
                st="symphony up"
            elif docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "opencode-${s}"; then
                st="opencode up"
            else
                st="-"
            fi
            printf '  %-20s %-7s %-11s %s\n' "${s}" "${p:-?}" "${k:--}" "${st}"
        done
        printf '\n  use one:  ./scripts/symphony -p <slug> check\n\n'
        ;;

    watch)
        # No dashboard by design — the directories are the state, so this is
        # just `ls` on a timer.
        while true; do
            clear
            date
            queue_status
            sleep "${SYMPHONY_WATCH_INTERVAL:-5}"
        done
        ;;

    add)
        # Under the gitlab tracker a file in todo/ is read by nothing. Writing
        # one and reporting success would leave you waiting on work that was
        # never queued.
        if [ "$(tracker_kind)" = "gitlab" ]; then
            red "the tracker is gitlab — work items are GitLab issues, not files."
            red "  create an issue and label it $(wf_scalar label_prefix)::todo"
            exit 1
        fi
        [ "$#" -ge 1 ] || { red 'usage: ./scripts/symphony add "what the agent should do" [--id ID] [--title TITLE]'; exit 1; }
        body="$1"; shift
        id=""; title=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --id)    id="$2"; shift 2 ;;
                --title) title="$2"; shift 2 ;;
                *) red "unknown option: $1"; exit 1 ;;
            esac
        done
        ensure_dirs
        [ -n "${id}" ] || id="SYM-$(date +%Y%m%d-%H%M%S)"
        [ -n "${title}" ] || title="${body%%$'\n'*}"
        # Keep the id inside what the tracker accepts (^[A-Za-z0-9][A-Za-z0-9._-]*$)
        case "${id}" in
            [A-Za-z0-9]*) : ;;
            *) red "id must start with a letter or digit: ${id}"; exit 1 ;;
        esac
        slug="$(printf '%s' "${title}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/-$//')"
        file="${QUEUE_PATH}/todo/${id}-${slug}.md"
        [ -e "${file}" ] && { red "already exists: ${file}"; exit 1; }
        now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        cat > "${file}" <<ITEM
---
id: ${id}
title: ${title}
priority: 5
labels: []
blocked_by: []
branch: null
attempts: 0
next_retry_at: null
session_id: null
created_at: ${now}
updated_at: ${now}
---

${body}
ITEM
        ok "queued ${file}"
        ;;

    stop)
        "${COMPOSE[@]}" stop symphony
        ok "symphony stopped. In-flight items stay in in-progress/ and resume on restart."
        ;;

    down)
        "${COMPOSE[@]}" down "$@"
        ;;

    *)
        red "unknown command: ${cmd}"
        # The whole leading comment block, found rather than hardcoded — a line
        # range silently starts printing the wrong thing the moment the header
        # grows, which is how it drifted before.
        awk 'NR>1 && /^#/ {print; next} NR>1 {exit}' "$0" >&2
        exit 1
        ;;
esac
