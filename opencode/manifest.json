{
  "manifest_version": 1,
  "image_version": "local",
  "opencode_version": "",
  "env_keys": [
    {"key": "LLM_API_BASE", "required": true},
    {"key": "LLM_API_KEY", "required": true},
    {"key": "BITBUCKET_BASE_URL", "required": false},
    {"key": "BITBUCKET_USER", "required": false},
    {"key": "BITBUCKET_PAT", "required": false},
    {"key": "JIRA_BASE_URL", "required": false},
    {"key": "JIRA_PAT", "required": false},
    {"key": "GITLAB_BASE_URL", "required": false},
    {"key": "GITLAB_USER", "required": false},
    {"key": "GITLAB_PAT", "required": false},
    {"key": "JFROG_BASE_URL", "required": false},
    {"key": "JFROG_PAT", "required": false},
    {"key": "CONFLUENCE_BASE_URL", "required": false},
    {"key": "CONFLUENCE_PAT", "required": false},
    {"key": "GIT_USER_NAME", "required": false},
    {"key": "GIT_USER_EMAIL", "required": false},
