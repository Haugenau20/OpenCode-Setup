{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "workplace": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Workplace LLM",
      "options": {
        "baseURL": "{file:/home/dev/secrets/llm_api_base}",
        "apiKey": "{file:/home/dev/secrets/llm_api_key}"
      },
      "models": {
        "default": {
          "name": "default"
        }
      }
    }
  },
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": "allow"
  }
}
