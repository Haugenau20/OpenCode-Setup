#!/usr/bin/env bash
# git-guard: refuse remote git operations unless ALLOW_REMOTE_GIT=1.
# Installed at /usr/local/bin/git (PATH-first), delegates to /usr/bin/git.
set -euo pipefail

REAL_GIT=/usr/bin/git

# git dispatches on the first non-option token, so a real invocation can put
# any number of GLOBAL options (-C <path>, -c <kv>, --git-dir=..., etc.)
# before the actual subcommand. Gating only on "$1" lets those sail straight
# past the guard (e.g. `git -C /workspace push`). Walk past them instead.
#
# Options below take their argument as a SEPARATE token. The long ones also
# accept a joined `--opt=value` form, which is handled generically below (any
# `--foo=bar` token is just skipped as one token, no lookup needed).
is_separate_arg_opt() {
    case "$1" in
        -C|-c|--git-dir|--work-tree|--namespace|--config-env|--exec-path|--attr-source|--super-prefix|--list-cmds)
            return 0 ;;
        *)
            return 1 ;;
    esac
}

# "$@" as an indexable array, so we can scan forward without consuming it —
# the real git still needs the untouched original at the bottom.
args=("$@")
argc=${#args[@]}

# Scan args[] starting at index $1 for the first non-option token (skipping
# global options / bare flags along the way). On a hit, sets REPLY to its
# index and returns 0; on exhaustion, sets REPLY=-1 and returns 1.
find_subcommand() {
    local i="$1" tok
    while [ "${i}" -lt "${argc}" ]; do
        tok="${args[${i}]}"
        case "${tok}" in
            --*=*)
                # joined long option, e.g. --git-dir=/path: one token
                i=$((i + 1))
                ;;
            -*)
                if is_separate_arg_opt "${tok}"; then
                    i=$((i + 2))   # flag + its separate argument
                else
                    i=$((i + 1))   # bare flag (-p, --paginate, --bare, ...);
                                   # an unrecognized -* token is also treated
                                   # as bare — a false-positive block is
                                   # acceptable, a bypass is not.
                fi
                ;;
            *)
                REPLY="${i}"
                return 0
                ;;
        esac
    done
    REPLY=-1
    return 1
}

sub=""
sub_idx=-1
if find_subcommand 0; then
    sub_idx="${REPLY}"
    sub="${args[${sub_idx}]}"
fi

case "${sub}" in
    push|fetch|pull|clone|ls-remote)
        if [ "${ALLOW_REMOTE_GIT:-0}" != "1" ]; then
            cat >&2 <<EOF
git ${sub}: blocked by workplace policy.

Remote git operations are disabled by default in this container. To enable:
  1. Set ALLOW_REMOTE_GIT=1 in your .env
  2. docker compose up -d
See docs/ALLOWING_GIT_PUSH.md for details.
EOF
            exit 1
        fi
        ;;
    remote)
        subsub=""
        subsub_idx=-1
        if find_subcommand $((sub_idx + 1)); then
            subsub_idx="${REPLY}"
            subsub="${args[${subsub_idx}]}"
        fi
        case "${subsub}" in
            add|set-url|set-branches|set-head|prune|update)
                if [ "${ALLOW_REMOTE_GIT:-0}" != "1" ]; then
                    echo "git remote ${subsub}: blocked (set ALLOW_REMOTE_GIT=1)" >&2
                    exit 1
                fi
                ;;
        esac
        ;;
esac

# ---- Second gate: destination allowlist -------------------------------------
# ALLOW_REMOTE_GIT is binary — once it is 1, every remote is reachable. That is
# fine for a human at a keyboard and too wide for a stack that needs remote git
# enabled but should only ever touch one group.
#
# GIT_REMOTE_ALLOWLIST narrows the *destination*: a whitespace- or
# comma-separated list of `host/path` prefixes. Unset or empty means no
# restriction, so existing setups are unaffected.
#
#   GIT_REMOTE_ALLOWLIST="gitlab.internal.example/my-group/"
#
# SCOPE — read this before relying on it. This is defence in depth, NOT a
# security boundary. The agent has an unrestricted bash tool and can call
# /usr/bin/git directly, straight past this PATH shim. Its job is to turn a
# mistake — a hallucinated remote, a stale branch config, a pasted URL — into a
# legible local error instead of a confusing 403 from the server. The real
# boundary is the credential: a project or group access token scoped to what
# the stack may reach, enforced server-side. See docs/ARCHITECTURE.md, "The
# credential model".

# real_git <args...> — run the real git with the SAME global options the caller
# used. `git -C /other/repo push origin` must resolve `origin` in /other/repo,
# not in the current directory, or the check reads a different repo's remotes
# than the command will actually push to. args[0..sub_idx-1] is exactly the
# global-option run that find_subcommand already walked past.
real_git() {
    if [ "${sub_idx}" -gt 0 ]; then
        "${REAL_GIT}" "${args[@]:0:${sub_idx}}" "$@"
    else
        "${REAL_GIT}" "$@"
    fi
}

# normalize_remote <url|remote-name> — reduce a git remote to `host/path` for
# comparison: drop scheme, userinfo, port, trailing `.git`. Handles both URL
# and scp-like (`git@host:group/repo`) syntax. Local paths pass through.
normalize_remote() {
    local url="${1}" host rest
    url="${url%%\?*}"
    case "${url}" in
        *://*)
            url="${url#*://}"
            url="${url#*@}"
            host="${url%%/*}"
            rest=""
            case "${url}" in */*) rest="/${url#*/}" ;; esac
            host="${host%%:*}"
            url="${host}${rest}"
            ;;
        /*|./*|../*|~*)
            ;;                                  # local path; left alone
        *:*)
            url="${url#*@}"
            url="${url%%:*}/${url#*:}"
        ;;
    esac
    url="${url#/}"
    url="${url%/}"
    url="${url%.git}"
    printf '%s' "${url}"
}

# resolve_remote_url <remote-name-or-url> — turn whatever the user typed into
# the URL git would actually contact. An empty argument means git picks the
# default, so mirror that lookup. A name that does not resolve is returned
# unchanged, which then fails the allowlist — the safe direction.
resolve_remote_url() {
    local ref="${1}" branch
    if [ -z "${ref}" ]; then
        branch="$(real_git symbolic-ref --short -q HEAD 2>/dev/null || true)"
        [ -n "${branch}" ] && ref="$(real_git config --get "branch.${branch}.remote" 2>/dev/null || true)"
        [ -z "${ref}" ] && ref="origin"
    fi
    case "${ref}" in
        *://*|/*|./*|../*|~*) printf '%s' "${ref}"; return 0 ;;
        *@*:*)                printf '%s' "${ref}"; return 0 ;;
    esac
    real_git remote get-url "${ref}" 2>/dev/null || printf '%s' "${ref}"
}

# remote_allowed <url> — prefix-match the normalized destination against each
# allowlist entry, on a path-segment boundary so `…/sandbox` cannot be
# satisfied by `…/sandbox-evil`.
remote_allowed() {
    local target entry
    target="$(normalize_remote "${1}")"
    [ -z "${target}" ] && return 1
    for entry in ${GIT_REMOTE_ALLOWLIST//,/ }; do
        entry="$(normalize_remote "${entry}")"
        [ -z "${entry}" ] && continue
        case "${target}/" in
            "${entry}"/*) return 0 ;;
        esac
    done
    return 1
}

deny_remote() {
    cat >&2 <<EOF
git ${sub}: destination not in GIT_REMOTE_ALLOWLIST.

  requested: ${1}
  allowed:   ${GIT_REMOTE_ALLOWLIST}

This container is restricted to the sandbox remotes listed above. Widen
GIT_REMOTE_ALLOWLIST in .env only if you mean to.
EOF
    exit 1
}

# find_opt_value <--opt> <from-index> — value of an option that git's
# parse-options accepts in either `--opt=value` or `--opt value` form. Sets
# REPLY to the value and returns 0 on a hit; REPLY="" and 1 otherwise.
find_opt_value() {
    local want="$1" i="$2" tok
    while [ "${i}" -lt "${argc}" ]; do
        tok="${args[${i}]}"
        case "${tok}" in
            "${want}"=*)
                REPLY="${tok#*=}"
                return 0 ;;
            "${want}")
                if [ $((i + 1)) -lt "${argc}" ]; then
                    REPLY="${args[$((i + 1))]}"
                    return 0
                fi
                ;;
        esac
        i=$((i + 1))
    done
    REPLY=""
    return 1
}

# has_flag <--flag> <from-index> — is this exact bare flag present?
has_flag() {
    local want="$1" i="$2"
    while [ "${i}" -lt "${argc}" ]; do
        [ "${args[${i}]}" = "${want}" ] && return 0
        i=$((i + 1))
    done
    return 1
}

# add_all_remotes — every remote configured in this repo. The commands that
# contact more than one destination per invocation need all of them checked,
# not just whichever git would have picked by default.
add_all_remotes() {
    local r
    while IFS= read -r r; do
        [ -n "${r}" ] && targets+=("${r}")
    done < <(real_git remote 2>/dev/null || true)
}

# add_remote_or_group <name> — `remotes.<name>` in the config is a GROUP: one
# name standing for several remotes. Expand it, or fall through to the name
# itself when no such group exists.
add_remote_or_group() {
    local name="$1" members r
    members="$(real_git config --get-all "remotes.${name}" 2>/dev/null || true)"
    if [ -n "${members}" ]; then
        for r in ${members}; do
            targets+=("${r}")
        done
    else
        targets+=("${name}")
    fi
}

if [ -n "${GIT_REMOTE_ALLOWLIST:-}" ]; then
    # Every destination this invocation could contact. One empty element means
    # "none was named, so check whatever git would resolve by default"; an empty
    # ARRAY means nothing will be contacted at all and there is nothing to gate.
    targets=()
    idx=0

    case "${sub}" in
        clone)
            # first non-option token after `clone` is the URL
            if find_subcommand $((sub_idx + 1)); then
                targets+=("${args[${REPLY}]}")
            else
                targets+=("")
            fi
            ;;
        push)
            # `--repo=<url>` is a destination in its own right — git falls back
            # to it when no repository is named positionally — and it is written
            # as a joined long option, which the scanner above skips as one
            # token. Left unread it walked straight past this gate.
            if find_opt_value --repo $((sub_idx + 1)); then
                targets+=("${REPLY}")
            fi
            if find_subcommand $((sub_idx + 1)); then
                targets+=("${args[${REPLY}]}")
            fi
            # Note: `push --all` means all BRANCHES, not all remotes.
            [ "${#targets[@]}" -gt 0 ] || targets+=("")
            ;;
        fetch)
            # `--all` contacts every configured remote and `--multiple` reads
            # every positional as one, so checking a single token would wave the
            # rest through.
            if has_flag --all $((sub_idx + 1)); then
                add_all_remotes
            elif has_flag --multiple $((sub_idx + 1)); then
                idx=$((sub_idx + 1))
                while find_subcommand "${idx}"; do
                    add_remote_or_group "${args[${REPLY}]}"
                    idx=$((REPLY + 1))
                done
            elif find_subcommand $((sub_idx + 1)); then
                targets+=("${args[${REPLY}]}")
            else
                targets+=("")
            fi
            ;;
        pull|ls-remote)
            # optional; absent means git resolves the default remote
            if find_subcommand $((sub_idx + 1)); then
                targets+=("${args[${REPLY}]}")
            else
                targets+=("")
            fi
            ;;
        remote)
            case "${subsub}" in
                # `remote add <name> <url>` / `remote set-url [--add] <name> <url>`
                add|set-url)
                    if find_subcommand $((sub_idx + 1)) \
                        && find_subcommand $((REPLY + 1)) \
                        && find_subcommand $((REPLY + 1)); then
                        targets+=("${args[${REPLY}]}")
                    fi
                    ;;
                # `remote update [<group|remote>...]` — bare, it updates every
                # remote; named, each argument may itself be a group.
                update)
                    # From after `update` itself, not after `remote` — the
                    # subcommand token is not one of its arguments.
                    idx=$((subsub_idx + 1))
                    if find_subcommand "${idx}"; then
                        while find_subcommand "${idx}"; do
                            add_remote_or_group "${args[${REPLY}]}"
                            idx=$((REPLY + 1))
                        done
                    else
                        add_all_remotes
                    fi
                    ;;
            esac
            ;;
    esac

    # Zero targets is the "nothing will be contacted" case (`fetch --all` in a
    # repo with no remotes); the loop then correctly checks nothing.
    for target_ref in ${targets[@]+"${targets[@]}"}; do
        resolved="$(resolve_remote_url "${target_ref}")"
        remote_allowed "${resolved}" || deny_remote "${resolved}"
    done
fi

exec "${REAL_GIT}" "$@"
