# TEMPLATE — do not edit this file to toggle anything.
#
# This is the build-time SEED. On a container's first boot the entrypoint copies
# it to your LIVE switch file at:
#
#     ~/.config/opencode/disabled.yaml   (inside the container)
#
# Edit THAT file to turn things on/off, then restart. Editing this template has
# no effect on a running stack (it is only re-read into a brand-new config
# volume). Two easy ways to edit the live file:
#
#   • In-container:  docker exec -u dev -it opencode-<slug> \
#                      vim /home/dev/.config/opencode/disabled.yaml
#   • From the host: set USER_LAYER_PATH=./user-layer in .env (bind-mounts the
#     config dir), then edit ./user-layer/disabled.yaml in your editor.
#
# Run `/plugins` in the TUI for the live plugin catalog and on/off state.
#
# Two different defaults, by design:
#   • agents / skills / commands / mcp ship ENABLED — list a name to turn it OFF.
#   • plugins ship DISABLED (opt-in) — list a name under `enabled` to turn it ON.

# --- Bundled agents/skills/commands/mcp: ON by default ------------------------
# Add a name to a list below to turn that item OFF.
disabled:
  agents:  []
  skills:  []
  commands: []
  mcp:     []

# --- Plugins: OFF by default (opt-in) -----------------------------------------
# Uncomment a name under `enabled` to turn that plugin ON. These are baked into
# the image with their dependencies vendored — enabling one needs no network.
plugins:
  enabled:
    # - superpowers         # skills library: brainstorming, writing-plans,
    #                       #   systematic-debugging, TDD, code-review, etc.
    # - dcp                 # dynamic context pruning — trims stale tool output
    #                       #   from the context window to save tokens.
    # - opencode-workspace  # plan_save/plan_read tools + background-agent
    #                       #   delegation (async sub-agents).
